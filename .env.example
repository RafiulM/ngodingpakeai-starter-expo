# pnpm run setup creates private local values in .env.local.
BETTER_AUTH_SECRET=
# Public origin of the Express API. The API listens on its port, on every
# network interface (HOST=0.0.0.0), so phones on your Wi-Fi can reach it.
BETTER_AUTH_URL=http://localhost:4000
# Optional comma-separated browser origins allowed to call the API with cookies,
# e.g. an Expo web build or an admin site. The native app needs none: the API
# trusts its scheme (starter.config.json) and, in development, Expo Go.
# TRUSTED_ORIGINS=
# Set when the API runs behind a reverse proxy: a hop count (e.g. 1) or subnets
# (e.g. loopback). Never true: that trusts any client-supplied X-Forwarded-For.
# TRUST_PROXY=
# fatal | error | warn | info | debug | trace | silent. Defaults: debug in dev, info in production.
# LOG_LEVEL=
# Log every SQL statement (parameters omitted) at debug level.
# LOG_SQL=false
# Leave blank for automatic Docker setup, or supply your own connection string.
DATABASE_URL=
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
# Optional fixed local database port. Setup chooses a free high port by default.
# POSTGRES_PORT=5433
